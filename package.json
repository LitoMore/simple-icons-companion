{
	"name": "simple-icons-companion",
	"description": "Userscript that improves Simple Icons SVG diffs on GitHub.",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "node scripts/build.js",
		"check": "node --check simple-icons-companion.user.js",
		"typecheck": "tsgo --noEmit",
		"lint": "prettier --check . && xo",
		"test": "node --run typecheck && node --run build && node --run check && node --run lint"
	},
	"devDependencies": {
		"@litomore/xo-config": "^0.1.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260503.1",
		"esbuild": "^0.28.0",
		"prettier": "^3.8.3",
		"xo": "^2.0.2"
	}
}
